{
  "name": "money-mind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "validate:layer3": "node scripts/v2/layer3-browser-acceptance.mjs",
    "test:financial-graph": "node scripts/v2/validate-financial-graph-contracts.mjs",
    "test:financial-graph-engine": "node scripts/v2/validate-financial-graph-engine.mjs",
    "test:financial-graph-transform": "node scripts/v2/validate-financial-graph-transform.mjs",
    "test:financial-projection": "node tests/financial/projectFinancials.test.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && npx -y firebase-tools@latest deploy --only hosting",
    "deploy:full": "npm run build && npx -y firebase-tools@latest deploy",
    "remotion:studio": "remotion studio remotion/index.ts",
    "render:intro": "remotion render remotion/index.ts IntroComposition out/money-mind-financial-energy-intro-1080p.mp4 --codec=h264",
    "render:cinematic-reveal": "remotion render remotion/index.ts CinematicLogoReveal out/money-mind-cinematic-logo-reveal-1440p.mp4 --codec=h264",
    "render:cinematic-reveal-vertical": "remotion render remotion/index.ts CinematicLogoRevealVertical out/money-mind-cinematic-logo-reveal-vertical.mp4 --codec=h264"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "firebase": "^12.15.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "three": "^0.185.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.489",
    "@remotion/renderer": "^4.0.489",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright-core": "^1.62.1",
    "remotion": "^4.0.489",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.1"
  }
}
