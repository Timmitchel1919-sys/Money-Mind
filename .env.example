# Money AI provider flag — do NOT put a real API key here.
# Vite exposes every VITE_-prefixed variable to the client bundle, so this
# can only ever be a feature flag naming which provider is configured on
# a secure backend (e.g. a Firebase Cloud Function). Leave unset or "local"
# to keep Money AI on the built-in deterministic local rules engine.
VITE_MONEY_AI_PROVIDER=local
# Money Mind V2 feature flags (safe defaults)
VITE_V2_ENABLED=false
VITE_V2_SPATIAL_UI=false
VITE_V2_GRAPH_ENGINE=false
VITE_V2_MOTION_ENGINE=false
VITE_V2_SIMULATION=false
VITE_V2_AI=false
